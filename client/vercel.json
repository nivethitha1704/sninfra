{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://sninfra.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://sninfra.onrender.com/uploads/$1" },
    { "source": "/photos/(.*)", "destination": "https://sninfra.onrender.com/photos/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
